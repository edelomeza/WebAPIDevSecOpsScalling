{
  "stryker-config": {
    "project": "WebAPIDevSecOps.csproj",
    "test-projects": [
      "../UnitTest/UnitTest.csproj"
    ],
    "mutate": [
      "**",
      "!**/Migrations/**",
      "!**/Models/**",
      "!**/Dto/**",
      "!**/Program.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 60
    },
    "reporters": ["html", "progress", "json"],
    "coverage-analysis": "perTest",
    "concurrency": 4,
    "additional-timeout": 15000,
    "verbosity": "info"
  }
}
